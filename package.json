{
  "name": "refram",
  "version": "0.1.2",
  "description": "Visual timeline debugger for web animation",
  "keywords": [
    "animation",
    "devtools",
    "gsap",
    "timeline",
    "visual-debugger"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinddc/refram.git"
  },
  "bugs": {
    "url": "https://github.com/jinddc/refram/issues"
  },
  "homepage": "https://github.com/jinddc/refram#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package:ssr": "node scripts/verify-package-ssr.mjs",
    "prepack": "npm run build",
    "verify:visual:devtools-editor-v2": "node scripts/verify-devtools-editor-v2.mjs",
    "verify:visual:devtools-editor-lanes": "node scripts/verify-devtools-editor-lanes.mjs"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "gsap": "^3.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
