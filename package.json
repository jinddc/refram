{
  "name": "motion-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "verify:visual:devtools-editor-v2": "node scripts/verify-devtools-editor-v2.mjs",
    "verify:visual:devtools-editor-lanes": "node scripts/verify-devtools-editor-lanes.mjs"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "gsap": "^3.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
