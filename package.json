{
  "name": "motion-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:visual:reveal": "node scripts/verify-reveal.mjs",
    "verify:visual:timeline": "node scripts/verify-timeline.mjs",
    "verify:visual:timeline-debugger": "node scripts/verify-timeline-debugger.mjs"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "gsap": "^3.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
