{
  "name": "refram",
  "version": "0.1.4",
  "description": "Visual timeline debugger for web animation",
  "keywords": [
    "animation",
    "devtools",
    "gsap",
    "timeline",
    "visual-debugger"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinddc/refram.git"
  },
  "bugs": {
    "url": "https://github.com/jinddc/refram/issues"
  },
  "homepage": "https://github.com/jinddc/refram#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "gsap": "^3.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
